# RTB - site statique sur Apache (hébergement OVH)
#
# IMPORTANT : si un .htaccess existe déjà sur le serveur (par exemple l'ancien WordPress), ne pas l'écraser
# sans le lire. Dans ce cas, recopier uniquement le bloc « HTTPS » ci-dessous tout en haut du fichier existant,
# avant ses propres règles, et laisser le reste en place.

Options -Indexes

# --- HTTPS : tout passe par https://rtb.fr (sans www) -----------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # www.rtb.fr -> https://rtb.fr (une seule redirection, http ou https)
    RewriteCond %{HTTP_HOST} ^www\.rtb\.fr$ [NC]
    RewriteRule ^ https://rtb.fr%{REQUEST_URI} [L,R=301]

    # http://rtb.fr -> https://rtb.fr (le second test évite une boucle derrière un relais qui termine le TLS)
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^ https://rtb.fr%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_headers.c>
    # Le navigateur ne redemandera pas le site en http pendant un an (sans includeSubDomains ni preload).
    Header always set Strict-Transport-Security "max-age=31536000"
    # Filet de sécurité : toute ressource restée en http:// est demandée en https://.
    Header always set Content-Security-Policy "upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# --- Fichiers internes qui ne doivent pas être publics ----------------------------------------------
<FilesMatch "\.(md|bak)$">
    Require all denied
</FilesMatch>
